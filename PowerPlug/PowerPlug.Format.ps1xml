<?xml version="1.0" encoding="utf-8"?>
<!-- Table views for PowerPlug output types where the PowerShell default (a list once there are more than four
     properties) is harder to scan than a table. -->
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>PathEntry</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.PathEntry</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Index</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Exists</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Duplicate</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Exists</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Duplicate</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>PortTestResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.PortTestResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Host</Label></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Open</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>LatencyMs</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Error</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Host</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Open</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LatencyMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Error</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ListeningPort</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.ListeningPort</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Protocol</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>LocalAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ProcessId</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ProcessName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Protocol</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LocalAddress</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ProcessId</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ProcessName</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>UrlTestResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.UrlTestResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Url</Label></TableColumnHeader>
          <TableColumnHeader><Label>Success</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>StatusCode</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>LatencyMs</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>RedirectTo</Label></TableColumnHeader>
          <TableColumnHeader><Label>Error</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Url</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Success</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>StatusCode</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LatencyMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>RedirectTo</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Error</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>TlsCertificateInfo</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.TlsCertificateInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Host</Label></TableColumnHeader>
          <TableColumnHeader><Label>Subject</Label></TableColumnHeader>
          <TableColumnHeader><Label>Issuer</Label></TableColumnHeader>
          <TableColumnHeader><Label>NotAfter</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>DaysRemaining</Label><Width>13</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ChainTrusted</Label><Width>12</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Host</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Issuer</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>NotAfter</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DaysRemaining</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ChainTrusted</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>DirectorySizeInfo</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.DirectorySizeInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Size</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Files</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Dirs</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Skipped</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Size</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>FileCount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DirectoryCount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>SkippedCount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>RenameResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.RenameResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Renamed</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>OldName</Label></TableColumnHeader>
          <TableColumnHeader><Label>NewName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Renamed</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>OldName</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>NewName</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ColorInfo</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.ColorInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Hex</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Rgb</Label></TableColumnHeader>
          <TableColumnHeader><Label>Hsl</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Hex</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Rgb</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Hsl</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>BenchmarkResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.BenchmarkResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Iterations</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>AverageMs</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>MedianMs</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>MinMs</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>MaxMs</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>StdDevMs</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Failures</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Iterations</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>AverageMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MedianMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MinMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MaxMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>StdDevMs</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Failures</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>FileEncodingInfo</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.FileEncodingInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Encoding</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>HasBom</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>LineEnding</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>LineCount</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Encoding</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>HasBom</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LineEnding</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LineCount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>LineEndingResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.LineEndingResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Changed</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>From</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>To</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Changed</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>From</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>To</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>FileSizeInfo</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.FileSizeInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Size</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>LastWriteTime</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>FullName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Size</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LastWriteTime</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>FullName</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>DirectoryComparison</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.DirectoryComparison</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Status</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>ReferenceSize</Label><Width>13</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>DifferenceSize</Label><Width>14</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>RelativePath</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ReferenceSize</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DifferenceSize</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>RelativePath</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>HashComparisonResult</Name>
      <ViewSelectedBy><TypeName>PowerPlug.Models.HashComparisonResult</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><PropertyName>Path</PropertyName></ListItem>
          <ListItem><PropertyName>Algorithm</PropertyName></ListItem>
          <ListItem><PropertyName>Match</PropertyName></ListItem>
          <ListItem><PropertyName>ComputedHash</PropertyName></ListItem>
          <ListItem><PropertyName>ExpectedHash</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>

  </ViewDefinitions>
</Configuration>
