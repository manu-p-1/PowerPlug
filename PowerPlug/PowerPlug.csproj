<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PowerPlug</RootNamespace>
    <AssemblyName>PowerPlug</AssemblyName>
    <Version>$(PowerPlugVersion)</Version>
    <ApplicationIcon>PowerPlugIcon.ico</ApplicationIcon>
    <Description>A cross-platform PowerShell 7+ cmdlet utility library</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/manu-p-1/PowerPlug</PackageProjectUrl>
    <PackageTags>csharp;library;utilities;dotnet;powershell;cmdlets</PackageTags>
    <PackageIcon>PowerPlugIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Module staging folder used by the StageModule target and the help generator. -->
    <ModuleOutputDir>$(MSBuildThisFileDirectory)../dist/PowerPlug/</ModuleOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\assets\PowerPlugIcon.png" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Update="PowerPlug.psd1;PowerPlug.psm1;PowerPlug.dll-Help.xml;PowerPlug.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerPlug.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    Stages a ready to import module folder under dist/PowerPlug. Each target framework lands in its own
    lib/<tfm> folder and PowerPlug.psm1 picks the right one at import time.
  -->
  <Target Name="StageModule" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ModuleRootFiles Include="$(ProjectDir)PowerPlug.psd1;$(ProjectDir)PowerPlug.psm1;$(ProjectDir)PowerPlug.dll-Help.xml;$(ProjectDir)PowerPlug.Format.ps1xml;$(ProjectDir)..\LICENSE.txt" />
      <ModuleLibFiles Include="$(TargetPath);@(DocFileItem->'%(FullPath)')" />
    </ItemGroup>
    <MakeDir Directories="$(ModuleOutputDir)lib/$(TargetFramework)/" />
    <Copy SourceFiles="@(ModuleRootFiles)" DestinationFolder="$(ModuleOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModuleLibFiles)" DestinationFolder="$(ModuleOutputDir)lib/$(TargetFramework)/" SkipUnchangedFiles="true" />
  </Target>

</Project>
